# Azure OpenAI (chat + embeddings deployments on the same account)
AZURE_OPENAI_ENDPOINT=https://<openai-account>.openai.azure.com/
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Azure AI Document Intelligence (used for scanned PDFs and images)
DOCUMENT_INTELLIGENCE_ENDPOINT=https://<docintel-account>.cognitiveservices.azure.com/

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
AZURE_SEARCH_INDEX=<index-name>
# Optional: only needed if the search service does not allow Entra ID (RBAC) auth
AZURE_SEARCH_ADMIN_KEY=

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT_NAME=<storage-account>
AZURE_STORAGE_CONTAINER=<container-name>

# Azure Cosmos DB
COSMOS_ENDPOINT=https://<cosmos-account>.documents.azure.com:443/
COSMOS_DATABASE_NAME=compliance-db
